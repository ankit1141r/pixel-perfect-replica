# ==============================================================================
# SPORTY - Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend / Client Environment Variables (Vite & Vercel)
# Exposed to browser via VITE_ prefix. Never place secrets here.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"

# ------------------------------------------------------------------------------
# Supabase Edge Function Secrets (Server-Side Only)
# Configure these in Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# or via Supabase CLI: supabase secrets set KEY=VALUE
# NEVER expose Google private keys in browser VITE_* variables.
# ------------------------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID="your_google_sheets_spreadsheet_id_here"
GOOGLE_SERVICE_ACCOUNT_EMAIL="sporty-sheets-sync@your-gcp-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional Supabase server keys used automatically inside Edge Functions runtime:
# SUPABASE_URL="https://your-project-id.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
